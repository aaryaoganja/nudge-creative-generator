# Copy to .env.local for local development. Never commit real values.
# On Railway, set these in the dashboard — .railway/railway.ts marks the secrets
# preserve() so applying IaC never overwrites or exposes a stored value.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. On Railway this is injected automatically from the
# managed Postgres service (see .railway/railway.ts: DATABASE_URL: db.env.DATABASE_URL).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nudge?schema=public"

NODE_ENV="development"

# ── The gate ────────────────────────────────────────────────────────────────

# The one password in front of the whole app. Everything behind it spends a live
# Gemini key per request, which is the reason it exists at all.
#
# Unset, it falls back to "NUDGE" — a default that is published in this
# repository and is therefore no protection. Set it on any deployment that is
# reachable from the internet.
#
# Rotating it invalidates every outstanding session AND every /keys override,
# because both are signed with keys derived from it. That is the intended way to
# kick everyone out.
APP_PASSWORD="NUDGE"

# ── Storefront ──────────────────────────────────────────────────────────────

# Hosts the fetcher may reach. This is both the SSRF control and a
# product-correctness control: the tool serves one brand, so a URL from anywhere
# else is a user error worth reporting rather than a page worth fetching.
STORE_ALLOWED_HOSTS="beminimalist.co,global.beminimalist.co"

# Used when a command is not given an explicit origin.
STORE_ORIGIN="https://beminimalist.co"

# Shopify's JSON endpoints do not report currency; the storefront implies it.
STORE_CURRENCY="INR"

# Product photography lives on a different host to the storefront. It gets its
# own allowlist rather than being trusted because a storefront response
# happened to mention it.
IMAGE_CDN_HOSTS="cdn.shopify.com"

# ── Model providers (all optional) ──────────────────────────────────────────
# The pipeline degrades rather than refusing to boot. Without an image key the
# deterministic path still produces creatives, and the error is raised at the
# point of use — a missing key must never fail the health check.

# The whole pipeline runs on this one key: gemini-3.7-flash writes copy and
# scores creatives (it accepts image input), gemini-3-pro-image generates them.
GEMINI_API_KEY=""

# Verify what this key can actually see:  railway run npm run models
# gemini-3-pro-image is Nano Banana Pro (~$0.134/image). It does NOT support the
# extreme banner ratios (1:4, 4:1, 1:8, 8:1) that gemini-3.1-flash-image does,
# so leaderboard and skyscraper sizes are derived by crop/extend, not generated.
# GEMINI_IMAGE_MODEL="gemini-3-pro-image"
# GEMINI_TEXT_MODEL="gemini-3.7-flash"

# Not in use — no key. Wired so adding one later is config, not code.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Force a provider. Unset means "whichever key is present", Gemini first.
# IMAGE_PROVIDER="gemini"
# OPENAI_IMAGE_MODEL="gpt-image-1"

# ── Optional ────────────────────────────────────────────────────────────────

# OPTIONAL, and no longer needed for enrichment to work.
#
# Shopify's JSON returns the product `description` field only; the rendered page
# also carries ingredient breakdowns, how-to-use, "why it works" and FAQ blocks
# from metafields and theme sections. That extra material is what a brief needs
# in order to answer an objection or explain a mechanism, and the scorer uses it
# as a wider source of truth when checking claims.
#
# A Shopify theme renders all of it server-side, so src/lib/scrape/page-text.ts
# reads it directly with no key and no third party, and that is now the default
# path. Set this only for a storefront that genuinely assembles its content in a
# browser; it is tried as a fallback when the direct read comes back empty or
# refused.
#
# Strictly an enrichment either way: prices, concentrations and images still
# come from the structured JSON, and both readers failing degrades copy depth
# rather than failing the run. It is reported on screen rather than passing
# silently, because a thin brief and a disobedient model look identical
# otherwise.
FIRECRAWL_API_KEY=""
