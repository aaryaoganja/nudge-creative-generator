# Copy to .env.local for local development. Never commit real values.

# Postgres connection string.
# On Railway this is injected automatically from the managed Postgres service
# (see .railway/railway.ts: DATABASE_URL: db.env.DATABASE_URL).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nudge?schema=public"

# Set in the Railway dashboard, not here. .railway/railway.ts marks it
# preserve() so applying IaC never overwrites or exposes the stored value.
ANTHROPIC_API_KEY=""

NODE_ENV="development"
